# Copy to .env and adjust. setup.sh / launch-servers.sh source this automatically.
#
# Cores and world databases clone from the public repositories in
# docker/common/repos.sh. Set GIT_BASE only to build from a mirror
# (${GIT_BASE}/<core name>.git). Leave it unset for GitHub.
# GIT_BASE=
#
# Removable disk: host-setup.sh discovers the filesystem UUID of this repo
# and bind-mounts it at WOW_VOLUME_MOUNT. Set WOW_VOLUME_UUID only to
# override that discovery.
# WOW_VOLUME_UUID=
WOW_VOLUME_MOUNT=/mnt/wow-nvme
# udisks owner. Empty uses whoever runs host-setup.
# WOW_MEDIA_USER=

MYSQL_ROOT_PASSWORD=wow
MYSQL_USER=wow
MYSQL_PASSWORD=wow
MYSQL_PUBLISH_PORT=13306

# GM login. Username realms use this name. WoD and Legion+ log in with
# <name>@<expansion>.local (admin@midnight.local, admin@wod.local, …).
ACCOUNT_NAME=admin
ACCOUNT_PASSWORD=admin

# How players connect. ./setup.sh access set writes this.
# loopback = vanilla.local and the other names on 127.0.0.x (default)
# ports    = one public address, a unique port for each realm
# public   = one DNS name and address per realm, stock ports (see .run/access.conf)
ACCESS=loopback

# haproxy  = stock client ports (loopback and public)
# ports    = unique host ports on 0.0.0.0
# loopback = one 127.0.0.x per realm; world stays on the unique ports
BIND_MODE=haproxy

# Used when ACCESS=ports. The menu sets this to the public address.
REALM_ADDRESS=127.0.0.1

# MariaDB dumps. Leave BACKUP_DIR empty until ./setup.sh backup path.
# Nothing is deleted by age.
# BACKUP_DIR=
BACKUP_SCHEDULE=off
BACKUP_HOUR=04

POINT_CLIENTS=0

# Seconds to wait after `up` for auth+world ports.
WOW_READY_WAIT=2700
